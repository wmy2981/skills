# =============================================================================
# img_recog — Model Mapping Configuration
# =============================================================================
# Copy this file to ~/.wmyskills/img_recog/model.yaml and customize.
# Empty model list = this provider has no vision-capable models available.
# =============================================================================

providers:
  openai:
    models:
      - gpt-4o
      - gpt-4o-mini

  deepseek:
    models:
      - deepseek-chat

  # siliconflow:
  #   models: []    # <-- no vision model configured

default:
  provider: openai
  model: gpt-4o-mini
