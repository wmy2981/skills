# model.yaml — Model-to-provider mapping
# After copying, review and adjust the default provider and model below.
#
# Copy to ~/.wmyskills/img-recog/model.yaml and customize.
# Empty model list = this provider has no vision-capable models available.
# =============================================================================

providers:
  openai:
    models:
      - gpt-5.6-luna
      - gpt-5.6-terra
      - gpt-5.6-sol
default:
  provider: openai
  model: gpt-5.6-luna
