# model.yaml — Model-to-provider mapping
# After copying, review and adjust the default provider and model below.
#
# Copy to ~/.wmyskills/img-recog/model.yaml and customize.
# Empty model list = this provider has no vision-capable models available.
# =============================================================================

providers:
  openai:
    models:
      - gpt-4o
      - gpt-4o-mini

  deepseek:
    models:
      - deepseek-chat

  # siliconflow:
  #   models: []    # <-- no vision model configured

default:
  provider: openai           # TODO: change to your preferred provider
  model: gpt-4o-mini         # TODO: change to your preferred vision model
