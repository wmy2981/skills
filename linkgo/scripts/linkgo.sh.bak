#!/bin/bash
# LinkGo v3 远程管理脚本
# 从 PROFILE.md 读取实例地址和密码

set -e

# ─── 读取配置 ──────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

BASE_URL="${LINKGO_HOST:-}"
PASSWORD="${LINKGO_PASSWORD:-}"

if [ -z "$BASE_URL" ] || [ -z "$PASSWORD" ]; then
    echo "错误: 环境变量 LINKGO_HOST 或 LINKGO_PASSWORD 未设置" >&2
    exit 1
fi

API_URL="${BASE_URL}/api"

# ─── 工具函数 ──────────────────────────────────────────────

get() {
    curl -s "${API_URL}$1" 2>/dev/null
}

auth_get() {
    curl -s -H "X-Admin-Password: ${PASSWORD}" "${API_URL}$1" 2>/dev/null
}

post() {
    local path="$1"
    local data="$2"
    curl -s -X POST -H "Content-Type: application/json" -d "$data" "${API_URL}${path}" 2>/dev/null
}

post_auth() {
    local path="$1"
    local data="$2"
    curl -s -X POST -H "Content-Type: application/json" \
        -d "{\"password\":\"${PASSWORD}\",\"content\":${data}}" \
        "${API_URL}${path}" 2>/dev/null
}

jsonify() {
    if command -v jq &>/dev/null; then
        echo "$1" | jq '.'
    else
        echo "$1"
    fi
}

# ─── 命令实现 ──────────────────────────────────────────────

cmd_list() {
    local mode="${1:---enabled}"
    local raw
    if [ "$mode" = "--all" ]; then
        raw=$(auth_get "/load_data.php")
    else
        raw=$(get "/get_show_data.php")
    fi
    jsonify "$raw"
}

cmd_add() {
    local card_json="$1"
    local raw
    raw=$(auth_get "/load_data.php")
    if echo "$raw" | grep -q '"error"'; then
        echo "错误: 无法加载数据，请检查密码和网络: $raw" >&2
        exit 1
    fi

    local new_id
    new_id=$(echo "$card_json" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('id',''))" 2>/dev/null || echo "")
    if [ -z "$new_id" ]; then
        echo "错误: 卡片 JSON 中缺少 id 字段" >&2
        exit 1
    fi

    local existing
    existing=$(echo "$raw" | python3 -c "
import sys, json
data = json.load(sys.stdin)
ids = [s.get('id','') for s in data.get('services',[])]
print('EXISTS' if '$new_id' in ids else 'OK')
" 2>/dev/null)
    if [ "$existing" = "EXISTS" ]; then
        echo "错误: id '$new_id' 已存在，请使用 edit 命令或更换 id" >&2
        exit 1
    fi

    local merged
    merged=$(echo "$raw" | python3 -c "
import sys, json
data = json.load(sys.stdin)
card = json.loads('''${card_json}''')
data['services'].append(card)
print(json.dumps(data, ensure_ascii=False))
" 2>/dev/null)

    local escaped
    escaped=$(echo "$merged" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read().strip()))' 2>/dev/null)
    local result
    result=$(post_auth "/update_json.php" "$escaped")
    jsonify "$result"
}

cmd_edit() {
    local target_id="$1"
    local patch_json="$2"
    local raw
    raw=$(auth_get "/load_data.php")
    if echo "$raw" | grep -q '"error"'; then
        echo "错误: 无法加载数据" >&2
        exit 1
    fi

    local merged
    merged=$(echo "$raw" | python3 -c "
import sys, json
raw = sys.stdin.read()
data = json.loads(raw)
patch = json.loads('''${patch_json}''')
found = False
for s in data['services']:
    if s.get('id') == '${target_id}':
        s.update({k:v for k,v in patch.items() if k != 'id'})
        found = True
        break
if not found:
    print('NOTFOUND', file=sys.stderr)
    sys.exit(1)
print(json.dumps(data, ensure_ascii=False))
" 2>/dev/null)

    local escaped
    escaped=$(echo "$merged" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read().strip()))' 2>/dev/null)
    local result
    result=$(post_auth "/update_json.php" "$escaped")
    jsonify "$result"
}

cmd_delete() {
    local target_id="$1"
    local raw
    raw=$(auth_get "/load_data.php")
    if echo "$raw" | grep -q '"error"'; then
        echo "错误: 无法加载数据" >&2
        exit 1
    fi

    local merged
    merged=$(echo "$raw" | python3 -c "
import sys, json
data = json.loads(sys.stdin.read())
data['services'] = [s for s in data['services'] if s.get('id') != '${target_id}']
print(json.dumps(data, ensure_ascii=False))
" 2>/dev/null)

    local escaped
    escaped=$(echo "$merged" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read().strip()))' 2>/dev/null)
    local result
    result=$(post_auth "/update_json.php" "$escaped")
    jsonify "$result"
}

cmd_enable() {
    local target_id="$1"
    cmd_edit "$target_id" '{"status": 1}'
}

cmd_disable() {
    local target_id="$1"
    cmd_edit "$target_id" '{"status": 0}'
}

cmd_page() {
    local page_json="$1"
    local raw
    raw=$(auth_get "/load_data.php")
    if echo "$raw" | grep -q '"error"'; then
        echo "错误: 无法加载数据" >&2
        exit 1
    fi

    local merged
    merged=$(echo "$raw" | python3 -c "
import sys, json
data = json.loads(sys.stdin.read())
page = json.loads('''${page_json}''')
data['page'] = page
print(json.dumps(data, ensure_ascii=False))
" 2>/dev/null)

    local escaped
    escaped=$(echo "$merged" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read().strip()))' 2>/dev/null)
    local result
    result=$(post_auth "/update_json.php" "$escaped")
    jsonify "$result"
}

cmd_upload_icon() {
    local file_path="$1"
    if [ ! -f "$file_path" ]; then
        echo "错误: 文件不存在: $file_path" >&2
        exit 1
    fi
    local result
    result=$(curl -s -X POST -H "X-Admin-Password: ${PASSWORD}" \
        -F "icons[]=@${file_path}" \
        "${API_URL}/upload_icon.php" 2>/dev/null)
    jsonify "$result"
}

cmd_icons() {
    local raw
    raw=$(auth_get "/get_icons.php")
    jsonify "$raw"
}

cmd_change_password() {
    local old_pwd="$1"
    local new_pwd="$2"
    local result
    result=$(post "/change_password.php" "{\"old_password\":\"${old_pwd}\",\"new_password\":\"${new_pwd}\"}")
    jsonify "$result"
    if echo "$result" | grep -q '"success"'; then
        if [ -f "$PROFILE_PATH" ]; then
            sed -i "s/密码 \`[^\`]*\`/密码 \`${new_pwd}\`/" "$PROFILE_PATH"
            echo "PROFILE.md 中的密码已同步更新" >&2
        fi
    fi
}

cmd_export() {
    auth_get "/load_data.php"
}

cmd_import() {
    local file_path="$1"
    if [ ! -f "$file_path" ]; then
        echo "错误: 文件不存在: $file_path" >&2
        exit 1
    fi
    local content
    content=$(python3 -c "import sys,json; print(json.dumps(open('${file_path}').read().strip()))" 2>/dev/null)
    local result
    result=$(post_auth "/update_json.php" "$content")
    jsonify "$result"
}

cmd_reset() {
    echo "⚠️  此操作将清空所有自定义卡片并恢复默认配置！" >&2
    echo -n "确认请输入 'yes'：" >&2
    read -r confirm
    if [ "$confirm" != "yes" ]; then
        echo "已取消" >&2
        exit 0
    fi
    local result
    result=$(post "/update_json.php" "{\"password\":\"${PASSWORD}\",\"content\":\"INITIALIZE_WEB_JSON\"}")
    jsonify "$result"
}

cmd_debug() {
    get "/debugInfo.php"
}

cmd_ping() {
    local raw
    raw=$(get "/get_show_data.php")
    if echo "$raw" | grep -q '"success"'; then
        echo "LinkGo 运行正常: ${BASE_URL}"
        local count
        count=$(echo "$raw" | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d['data']['services']))" 2>/dev/null || echo "?")
        echo "启用的服务卡片数: $count"
    else
        echo "LinkGo 不可达: ${BASE_URL}"
        exit 1
    fi
}

# ─── 路由 ──────────────────────────────────────────────────

case "${1:-}" in
    list)
        cmd_list "${2:---enabled}"
        ;;
    add)
        cmd_add "$2"
        ;;
    edit)
        cmd_edit "$2" "$3"
        ;;
    delete)
        cmd_delete "$2"
        ;;
    enable)
        cmd_enable "$2"
        ;;
    disable)
        cmd_disable "$2"
        ;;
    page)
        cmd_page "$2"
        ;;
    upload-icon)
        cmd_upload_icon "$2"
        ;;
    icons)
        cmd_icons
        ;;
    change-password)
        cmd_change_password "$2" "$3"
        ;;
    export)
        cmd_export
        ;;
    import)
        cmd_import "$2"
        ;;
    reset)
        cmd_reset
        ;;
    debug)
        cmd_debug
        ;;
    ping)
        cmd_ping
        ;;
    *)
        echo "LinkGo v3 远程管理工具" >&2
        echo "用法: $(basename "$0") <命令> [参数...]" >&2
        echo "" >&2
        echo "命令:" >&2
        echo "  list [--enabled|--all]   列出服务卡片（默认仅启用）" >&2
        echo "  add <json>              添加服务卡片" >&2
        echo "  edit <id> <json>        编辑服务卡片" >&2
        echo "  delete <id>             删除服务卡片" >&2
        echo "  enable <id>             启用服务卡片" >&2
        echo "  disable <id>            禁用服务卡片" >&2
        echo "  page <json>             修改页面设置" >&2
        echo "  upload-icon <path>      上传图标文件" >&2
        echo "  icons                   列出可用图标" >&2
        echo "  change-password <old> <new>  修改管理密码" >&2
        echo "  export                  导出完整配置" >&2
        echo "  import <file>           导入完整配置" >&2
        echo "  reset                   恢复默认配置" >&2
        echo "  debug                   获取调试信息" >&2
        echo "  ping                    连通性测试" >&2
        exit 1
        ;;
esac
