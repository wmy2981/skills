# Fun-ASR: Required Environment Variables
# Copy this file to .env and fill in your credentials.
# The script loads this file automatically from the script directory or current working directory.

# --- Required: API Credentials ---
# Alibaba Cloud Bailian (DashScope) API key for Fun-ASR speech recognition
# Also accepted under the alias DASHSCOPE_API_KEY for compatibility
BAILIAN_APIKEY=your-bailian-api-key

# --- Required: S3-Compatible Storage ---
# S3 endpoint URL (e.g., Alibaba Cloud OSS, MinIO, AWS S3)
S3_ENDPOINT=https://your-s3-endpoint
# S3 bucket name for audio file uploads
S3_BUCKET=your-bucket-name
# AWS credentials (optional if using IAM role or default credential chain)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# --- Optional: S3 Configuration ---
# S3 region (default: us-east-1)
S3_REGION=us-east-1
# Key prefix for uploaded audio files (default: asr-uploads)
S3_PREFIX=asr-uploads
