# Fun-ASR: Required Environment Variables
# Add these variables to ~/.wmyskills/.env (shared across skills) or copy this file to scripts/.env (takes priority).
# The script loads both automatically — scripts/.env takes priority over ~/.wmyskills/.env.

# --- Required: API Credentials ---
# Alibaba Cloud DashScope API key for Fun-ASR speech recognition
# Also accepted under the deprecated alias BAILIAN_APIKEY for compatibility
DASHSCOPE_API_KEY=

# --- Required: S3-Compatible Storage ---
# S3 endpoint URL (e.g., Alibaba Cloud OSS, MinIO, AWS S3)
S3_ENDPOINT=https://your-s3-endpoint
# S3 bucket name for audio file uploads
S3_BUCKET=your-bucket-name
# AWS credentials (optional if using IAM role or default credential chain)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Optional: S3 Configuration ---
# S3 region (default: us-east-1)
S3_REGION=
# Key prefix for uploaded audio files (default: asr-uploads)
S3_PREFIX=asr-uploads
