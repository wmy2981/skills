# FreshRSS: Required Environment Variables
# Copy this file to .env and fill in your credentials.
# The script loads this file automatically from the script directory or current working directory.

# --- Required: FreshRSS Instance ---
# Base URL of your FreshRSS instance (e.g., http://192.168.1.100:1180)
FRESHRSS_URL=http://your-freshrss-instance:1180

# API username (same as your FreshRSS login)
FRESHRSS_API_USER=your-username

# API password (set in FreshRSS → Settings → Profile → API Management)
FRESHRSS_API_PASSWORD=your-password
